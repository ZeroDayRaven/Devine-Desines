# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Flask
FLASK_ENV=production
DEBUG=false
SECRET_KEY=your-secret-key-min-32-characters

# Admin
ADMIN_API_KEY=your-admin-api-key-min-32-characters

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@devinedesignssa.com

# CORS
CORS_ORIGINS=https://devinedesignssa.com

# Analytics (Optional)
GA_TRACKING_ID=your-google-analytics-id
FB_PIXEL_ID=your-facebook-pixel-id
ANALYTICS_CONSENT=true

# WhatsApp (Optional)
WHATSAPP_API_KEY=your-whatsapp-api-key
