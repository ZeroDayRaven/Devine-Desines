# Backend Environment Variables
# Copy this to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:[REDACTED]@db:5432/dbname
SECRET_KEY=your-super-secret-key-here-min-32-chars

# Email Configuration (SendGrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@devinedesignssa.com

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,https://devinedesignssa.com

# Analytics & Tracking (Optional)
GA_TRACKING_ID=G-xxxxxxxxxxxxx
FB_PIXEL_ID=1384801683570697
ANALYTICS_CONSENT=true

# WhatsApp Integration (Optional)
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_ID=your-phone-id

# Admin Dashboard
ADMIN_API_KEY=admin-secret-key-change-me-in-production

# Flask Environment
FLASK_ENV=production
DEBUG=false
